# Optional — configure the local AI assistant (Ollama). Copy to backend/.env.
# The assistant runs fully on your machine; no API key, nothing leaves the laptop.
#
# 1. Install Ollama:  https://ollama.com
# 2. Pull a tool-capable model:  ollama pull qwen2.5
#
# Defaults work out of the box if Ollama runs on localhost with qwen2.5 pulled.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5
